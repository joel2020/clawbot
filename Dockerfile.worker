FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies
COPY control-api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy control-api source (config, logging, models, database, routers)
COPY control-api/ .

# Copy worker module into /app/worker/
COPY worker/ ./worker/

CMD ["celery", "-A", "worker.celery_app", "worker", "--loglevel=info", "--concurrency=4", "-Q", "default,agent_runs"]
