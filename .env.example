# ═══════════════════════════════════════════════════════════
#  Clawbot — Environment Variables
#  Copy to .env: cp .env.example .env
#  Then fill in every value marked CHANGE_ME
#  Generate secrets: openssl rand -hex 32
# ═══════════════════════════════════════════════════════════

# ── Postgres ──────────────────────────────────────────────
POSTGRES_DB=clawbot
POSTGRES_USER=clawbot
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── Azure OpenAI ──────────────────────────────────────────
# Azure Portal → your OpenAI resource → Keys and Endpoint
AZURE_API_KEY=CHANGE_ME_azure_openai_key
AZURE_API_BASE=https://YOUR-RESOURCE-NAME.openai.azure.com
AZURE_API_VERSION=2024-02-01

# Deployment names — Azure AI Studio → Deployments tab
# These are the names YOU gave to each model deployment
AZURE_DEPLOYMENT_PREMIUM=gpt-4o
AZURE_DEPLOYMENT_STANDARD=gpt-4o-mini
AZURE_DEPLOYMENT_CHEAP=gpt-4o-mini

# ── LiteLLM ───────────────────────────────────────────────
# Generate: openssl rand -hex 32
LITELLM_MASTER_KEY=CHANGE_ME_litellm_master_key

# ── FastAPI ───────────────────────────────────────────────
# Generate: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_fastapi_secret_key
ENVIRONMENT=production

# ── n8n ───────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=CHANGE_ME_n8n_encryption_key

# ── Grafana ───────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_grafana_password
